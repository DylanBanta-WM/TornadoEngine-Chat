{
    "name": "tornado-engine/chat",
    "description": "Tornado Engine core-module: talk with Claude from the website, and have it build new tools as modules.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "illuminate/support": "^13.0",
        "laravel/mcp": "^1.1.2",
        "tornado-engine/broker": ">=0.9"
    },
    "autoload": {
        "psr-4": {
            "TornadoEngine\\Chat\\": "src/"
        }
    },
    "extra": {
        "tornado": {
            "name": "Chat",
            "core": ">=0.20",
            "core-module": true,
            "provider": "TornadoEngine\\Chat\\ChatServiceProvider",
            "settings": "/administration/chat"
        },
        "branch-alias": {
            "dev-main": "0.9.x-dev"
        }
    }
}
